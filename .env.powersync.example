# PowerSync Environment Configuration
# Copy this file to .env.powersync and configure with your values

# ====================
# PowerSync Core Settings
# ====================

# PowerSync service port (default: 8080)
POWERSYNC_PORT=8080

# PowerSync admin UI port (default: 8081, dev only)
POWERSYNC_ADMIN_PORT=8081

# PowerSync dashboard port (default: 3002, monitoring)
POWERSYNC_DASHBOARD_PORT=3002

# ====================
# Database Configuration
# ====================

# PostgreSQL connection details (if not using DATABASE_URL)
# These are extracted from DATABASE_URL if not specified
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password
DATABASE_NAME=firstline_emr

# PostgreSQL replication slot name (PowerSync will create this)
POWERSYNC_REPLICATION_SLOT=powersync_slot

# PostgreSQL publication name (PowerSync will create this)
POWERSYNC_PUBLICATION=powersync_publication

# ====================
# Authentication
# ====================

# JWT configuration (should match your main app)
# If not set, will use JWT_SECRET from main .env
POWERSYNC_JWT_SECRET=${JWT_SECRET}

# JWT issuer (your app URL)
POWERSYNC_JWT_ISSUER=${NEXTAUTH_URL:-https://fajrmission.org}

# Allowed JWT algorithms
POWERSYNC_JWT_ALGORITHMS=HS256,RS256

# ====================
# Storage Configuration
# ====================

# Path to store PowerSync data (SQLite databases, checkpoints, etc)
POWERSYNC_DATA_PATH=./data/powersync

# Maximum database size per sync bucket (default: 10GB)
POWERSYNC_MAX_DATABASE_SIZE=10GB

# Compression for stored data (none, gzip, zstd)
POWERSYNC_COMPRESSION=zstd

# ====================
# Replication Settings
# ====================

# How often to poll PostgreSQL for changes (ms)
POWERSYNC_REPLICATION_POLL_INTERVAL=1000

# How often to create checkpoints (ms)
POWERSYNC_CHECKPOINT_INTERVAL=10000

# How often to compact the database (ms)
POWERSYNC_COMPACT_INTERVAL=3600000

# Maximum WAL size before forcing a checkpoint (MB)
POWERSYNC_MAX_WAL_SIZE=100

# ====================
# Performance Tuning
# ====================

# Maximum concurrent client connections
POWERSYNC_MAX_CONNECTIONS=100

# Connection timeout (ms)
POWERSYNC_CONNECTION_TIMEOUT=30000

# Statement timeout for queries (ms)
POWERSYNC_STATEMENT_TIMEOUT=60000

# Worker threads for processing
POWERSYNC_WORKER_THREADS=4

# Maximum memory per connection (MB)
POWERSYNC_MAX_MEMORY_PER_CONNECTION=50

# ====================
# Sync Configuration
# ====================

# Default batch size for initial sync
POWERSYNC_INITIAL_SYNC_BATCH_SIZE=100

# Default batch size for incremental sync
POWERSYNC_INCREMENTAL_SYNC_BATCH_SIZE=50

# Maximum records to sync per table
POWERSYNC_MAX_RECORDS_PER_TABLE=10000

# Sync timeout per batch (ms)
POWERSYNC_SYNC_TIMEOUT=30000

# ====================
# Admin Interface
# ====================

# Enable admin interface (should be false in production)
POWERSYNC_ADMIN_ENABLED=false

# Admin interface authentication (for development)
POWERSYNC_ADMIN_USER=admin
POWERSYNC_ADMIN_PASSWORD=changeme

# Generate password hash: echo -n "changeme" | sha256sum
POWERSYNC_ADMIN_PASSWORD_HASH=$2a$12$...

# ====================
# Dashboard Authentication
# ====================

# Dashboard basic auth credentials
DASHBOARD_USER=dashboard
DASHBOARD_PASSWORD=changeme

# Generate password hash for Caddy: caddy hash-password
DASHBOARD_PASSWORD_HASH=$2a$14$...

# ====================
# Monitoring & Logging
# ====================

# Log level (debug, info, warn, error)
POWERSYNC_LOG_LEVEL=info

# Enable metrics endpoint
POWERSYNC_METRICS_ENABLED=true

# Metrics port
POWERSYNC_METRICS_PORT=9090

# Enable health check endpoint
POWERSYNC_HEALTH_CHECK_ENABLED=true

# Health check interval (ms)
POWERSYNC_HEALTH_CHECK_INTERVAL=30000

# ====================
# Error Handling
# ====================

# Maximum retry attempts for failed operations
POWERSYNC_MAX_RETRIES=3

# Retry delay (ms)
POWERSYNC_RETRY_DELAY=1000

# Exponential backoff multiplier
POWERSYNC_BACKOFF_MULTIPLIER=2

# Maximum retry delay (ms)
POWERSYNC_MAX_RETRY_DELAY=60000

# ====================
# Security
# ====================

# Enable TLS for client connections (if not using reverse proxy)
POWERSYNC_TLS_ENABLED=false

# TLS certificate path
POWERSYNC_TLS_CERT_PATH=/certs/cert.pem

# TLS key path
POWERSYNC_TLS_KEY_PATH=/certs/key.pem

# Allowed origins for CORS
POWERSYNC_ALLOWED_ORIGINS=https://fajrmission.org,http://localhost:3000

# Enable rate limiting
POWERSYNC_RATE_LIMITING_ENABLED=true

# Rate limit per IP (requests per minute)
POWERSYNC_RATE_LIMIT_PER_IP=100

# ====================
# Development Settings
# ====================

# Enable debug mode (verbose logging, detailed errors)
POWERSYNC_DEBUG=false

# Enable SQL query logging
POWERSYNC_LOG_SQL_QUERIES=false

# Enable sync rule debugging
POWERSYNC_DEBUG_SYNC_RULES=false

# Pretty print JSON responses
POWERSYNC_PRETTY_JSON=false

# ====================
# Backup & Recovery
# ====================

# Enable automatic backups
POWERSYNC_BACKUP_ENABLED=true

# Backup interval (hours)
POWERSYNC_BACKUP_INTERVAL=24

# Backup retention (days)
POWERSYNC_BACKUP_RETENTION_DAYS=7

# Backup path
POWERSYNC_BACKUP_PATH=./backups/powersync

# ====================
# Feature Flags
# ====================

# Enable bidirectional sync (client can write)
POWERSYNC_BIDIRECTIONAL_SYNC=true

# Enable offline write queue
POWERSYNC_OFFLINE_WRITE_QUEUE=true

# Enable conflict resolution
POWERSYNC_CONFLICT_RESOLUTION=true

# Enable delta sync (only sync changes)
POWERSYNC_DELTA_SYNC=true

# Enable compression for sync data
POWERSYNC_SYNC_COMPRESSION=true

# ====================
# Custom Functions
# ====================

# Path to custom SQL functions
POWERSYNC_CUSTOM_FUNCTIONS_PATH=./powersync/custom-functions

# Enable custom functions
POWERSYNC_CUSTOM_FUNCTIONS_ENABLED=false

# ====================
# Migration Settings
# ====================

# Enable auto-migration from old schema
POWERSYNC_AUTO_MIGRATE=false

# Migration timeout (ms)
POWERSYNC_MIGRATION_TIMEOUT=300000

# Keep old data after migration
POWERSYNC_KEEP_OLD_DATA=true
