# =============================================================================
# Fajr Mission SSO Authentication Configuration
# =============================================================================
# Copy this file to .env.auth.local and fill in the values
# =============================================================================
#
# DNS RECORDS REQUIRED:
# Before deploying, create these DNS A/CNAME records pointing to your server:
#   - identity.fajrmission.org        -> your Coolify server IP
#   - console.storage.fajrmission.org -> your Coolify server IP (if using storage SSO)
#
# Note: analytics.fajrmission.org should already exist
# =============================================================================

# -----------------------------------------------------------------------------
# Zitadel Configuration
# -----------------------------------------------------------------------------

# Domain where Zitadel will be accessible
ZITADEL_DOMAIN=identity.example.com

# Port for Zitadel to listen on (default 7777)
# ZITADEL_PORT=7777

# Master key for encryption - MUST be exactly 32 characters
# Generate with: openssl rand -hex 16
ZITADEL_MASTERKEY=

# Database name for Zitadel (will be created in your Postgres)
ZITADEL_DATABASE=zitadel

# Initial admin credentials (only used on first run)
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# PostgreSQL Connection (uses your existing Postgres)
# -----------------------------------------------------------------------------

# These should match your existing Postgres configuration
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_SSL_MODE=disable

# -----------------------------------------------------------------------------
# OAuth2 Proxy - Shared Settings
# -----------------------------------------------------------------------------

# Cookie encryption secret - MUST be 32 bytes base64 encoded
# Generate with: openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=

# -----------------------------------------------------------------------------
# OAuth2 Proxy - Analytics (Drizzle Studio)
# -----------------------------------------------------------------------------
# Create these in Zitadel console after initial setup:
# 1. Go to Projects > Create Project > "Fajr Internal Tools"
# 2. Create Application > Web > "Analytics Dashboard"
# 3. Add redirect URI: https://analytics.fajrmission.org/oauth2/callback
# 4. Copy Client ID and Client Secret here

OAUTH2_PROXY_ANALYTICS_CLIENT_ID=
OAUTH2_PROXY_ANALYTICS_CLIENT_SECRET=

# Drizzle Studio master password (same as DRIZZLE_MASTERPASS in your main .env)
# This gets passed through to Drizzle Studio after SSO authentication
# DRIZZLE_MASTERPASS=your_master_password

# -----------------------------------------------------------------------------
# OAuth2 Proxy - Storage Console (RustFS)
# -----------------------------------------------------------------------------
# Same process as above:
# 1. Create Application > Web > "Storage Console"
# 2. Add redirect URI: https://console.storage.fajrmission.org/oauth2/callback
# 3. Copy Client ID and Client Secret here

OAUTH2_PROXY_STORAGE_CLIENT_ID=
OAUTH2_PROXY_STORAGE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# NextAuth Integration (for MedFlow EMR)
# -----------------------------------------------------------------------------
# Create another application in Zitadel:
# 1. Create Application > Web > "MedFlow EMR"
# 2. Add redirect URI: https://your-app-domain/api/auth/callback/zitadel
# 3. Copy credentials here

ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# OIDC Provider (Web App as Identity Provider)
# -----------------------------------------------------------------------------
# The web app acts as an OIDC Identity Provider for Zitadel federation.
# This allows admins to use their existing web app credentials (email/password
# or passkey) to authenticate to Zitadel-protected services like analytics.

# Secret for signing OIDC cookies and tokens
# Generate with: openssl rand -hex 16
OIDC_PROVIDER_SECRET=

# OIDC Client credentials for Zitadel to authenticate with the web app
# These should be configured in Zitadel as a Generic OIDC Identity Provider
OIDC_ZITADEL_CLIENT_ID=your-client-id
OIDC_ZITADEL_CLIENT_SECRET=

# Issuer URL (defaults to https://fajrmission.org in production)
# OIDC_ISSUER_URL=https://fajrmission.org

# Zitadel callback URL for OIDC federation
# ZITADEL_CALLBACK_URL=https://identity.fajrmission.org/ui/login/login/externalidp/callback

# -----------------------------------------------------------------------------
# Zitadel Generic OIDC IdP Configuration (Manual Setup)
# -----------------------------------------------------------------------------
# After setting the above variables, configure Zitadel:
#
# 1. Go to Zitadel Console (https://identity.fajrmission.org)
# 2. Navigate to: Settings > Identity Providers
# 3. Click "New" and select "Generic OIDC"
# 4. Configure:
#    - Name: Fajr EMR
#    - Issuer: https://fajrmission.org/api/oidc
#    - Client ID: fajr-emr-oidc (or your OIDC_ZITADEL_CLIENT_ID)
#    - Client Secret: (your OIDC_ZITADEL_CLIENT_SECRET)
#    - Scopes: openid profile email
# 5. Enable "Auto-create user" for account creation
# 6. Enable "Link by email" for account linking
# 7. Save and activate the Identity Provider
