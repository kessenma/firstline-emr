{
  "name": "web",
  "version": "1.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev --webpack",
    "dev:turbo": "node ./node_modules/next/dist/bin/next dev",
    "build": "NODE_ENV=production ~/.bun/bin/bun --bun next build",
    "build:strict": "NODE_ENV=production ~/.bun/bin/bun --bun next build",
    "build:turbopack": "NODE_ENV=production ~/.bun/bin/bun --bun next build --turbopack",
    "build:standalone": "next build && cp -r public .next/standalone/apps/web/ && cp -r .next/static .next/standalone/apps/web/.next/",
    "docker:build": "next build",
    "start": "~/.bun/bin/bun --bun next start",
    "start:standalone": "~/.bun/bin/bun .next/standalone/apps/web/server.js",
    "lint": "echo '⚠️  Linting skipped (ESLint 9 config migration needed)' && exit 0",
    "lint:check": "eslint --version && echo 'ESLint available but config needs migration to flat config'",
    "check-types": "~/.bun/bin/bun --bun tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "~/.bun/bin/bun db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:check": "drizzle-kit check",
    "db:check-pending": "~/.bun/bin/bun scripts/check-migrations.ts",
    "db:test": "~/.bun/bin/bun -e \"import { testConnection } from './db/connection'; testConnection();\"",
    "db:test-setup": "~/.bun/bin/bun db/testSetup.ts",
    "db:check-patient-data": "~/.bun/bin/bun scripts/fix-malformed-patient-data.ts",
    "db:fix-patient-data": "~/.bun/bin/bun scripts/fix-malformed-patient-data.ts fix",
    "db:realtime": "~/.bun/bin/bun scripts/apply-realtime-migration.ts",
    "db:realtime:test": "~/.bun/bin/bun scripts/apply-realtime-migration.ts --test",
    "db:realtime:monitor": "~/.bun/bin/bun scripts/monitor-realtime-connections.ts",
    "db:realtime:watch": "~/.bun/bin/bun scripts/monitor-realtime-connections.ts --watch",
    "test:signup": "~/.bun/bin/bun scripts/test-signup.ts",
    "test:admin-notifications": "~/.bun/bin/bun scripts/test-admin-notifications.ts",
    "test:signup-notifications": "~/.bun/bin/bun scripts/test-signup-with-notifications.ts",
    "test:signup-api": "bash scripts/test-signup-api.sh",
    "debug:notifications": "~/.bun/bin/bun scripts/debug-notifications.ts",
    "backfill:notifications": "~/.bun/bin/bun scripts/backfill-notification-assignments.ts",
    "test:notifications-api": "~/.bun/bin/bun scripts/test-notifications-api.ts",
    "check:user": "~/.bun/bin/bun scripts/check-user.ts",
    "test:login": "~/.bun/bin/bun scripts/test-login.ts",
    "scan:auth": "~/.bun/bin/bun scripts/scan-mobile-auth.js",
    "scan:client-pages": "bash scripts/find-client-pages.sh",
    "upgrade:next16": "npx @next/codemod@latest upgrade latest",
    "validate": "bun run check-types && bun run build",
    "test:build": "bun run validate && echo '✅ Build validation passed!'",
    "precommit": "bun run check-types",
    "ci": "bun run validate",
    "kill:3000": "lsof -ti:3000 | xargs kill -9 2>/dev/null || echo '✅ Port 3000 is clear'",
    "kill:3001": "lsof -ti:3001 | xargs kill -9 2>/dev/null || echo '✅ Port 3001 is clear'",
    "kill:all": "lsof -ti:3000,3001 | xargs kill -9 2>/dev/null || echo '✅ All ports clear'",
    "kill": "lsof -ti:3000,3001 | xargs kill -9 2>/dev/null; rm -f .next/dev/lock; echo '✅ Killed Next.js processes and cleared lock'",
    "dev:clean": "pnpm run kill && npx next dev --webpack"
  },
  "overrides": {
    "@livekit/components-react": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "typescript": "5.7.3",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.3.6",
    "lowlight": "^2.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.908.0",
