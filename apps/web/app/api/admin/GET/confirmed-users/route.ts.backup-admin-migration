// app/api/admin/GET/confirmed-users/route.ts

export const dynamic = "force-dynamic";

import { NextRequest, NextResponse } from "next/server";
import { db } from "@/db";
import { users } from "@/db/schema";
import { and, eq, desc } from "drizzle-orm";
import { verifyAdminToken } from "@/utils/adminAPI";

export async function GET(request: NextRequest) {
  try {
    // Verify admin access
    const decoded = await verifyAdminToken(request);
    if (!decoded) {
      return NextResponse.json(
        { error: "Unauthorized - Admin access required" },
        { status: 401 },
      );
    }

    // Find all admin-created users who have confirmed their accounts
    const confirmedUsers = await db
      .select({
        id: users.id,
        firstName: users.firstName,
        lastName: users.lastName,
        email: users.email,
        accountType: users.accountType,
        doctorSpecialty: users.doctorSpecialty,
        emailSentDate: users.emailSentDate,
        confirmationTokenExpiry: users.confirmationTokenExpiry,
        adminCreatedBy: users.adminCreatedBy,
        adminCreatedDate: users.adminCreatedDate,
      })
      .from(users)
      .where(
        and(eq(users.isAdminCreated, true), eq(users.accountConfirmed, true)),
      )
      .orderBy(desc(users.adminCreatedDate));

    return NextResponse.json({
      success: true,
      confirmedUsers,
    });
  } catch (error) {
    console.error("Fetch confirmed users error:", error);
    return NextResponse.json(
      { error: "Internal server error" },
      { status: 500 },
    );
  }
}
