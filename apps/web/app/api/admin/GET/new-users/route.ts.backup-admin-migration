// app/api/admin/GET/new-users/route.ts

export const dynamic = "force-dynamic";

import { NextRequest, NextResponse } from "next/server";
import { db } from "@/db";
import { users } from "@/db/schema";
import { isNull, desc, count } from "drizzle-orm";
import { verifyAdminToken } from "@/utils/adminAPI";

export async function GET(request: NextRequest) {
  try {
    // Verify admin access
    const decoded = await verifyAdminToken(request);
    if (!decoded) {
      return NextResponse.json(
        { message: "Unauthorized access" },
        { status: 403 },
      );
    }

    // Parse query parameters
    const { searchParams } = new URL(request.url);
    const page = parseInt(searchParams.get("page") || "1", 10);
    const limit = parseInt(searchParams.get("limit") || "20", 10);
    const offset = (page - 1) * limit;

    // Query for new users: authorized is null (not set yet)
    const filter = isNull(users.authorized);

    // Get total count of new users for pagination
    const [{ value: totalUsers }] = await db
      .select({ value: count() })
      .from(users)
      .where(filter);

    // Fetch new/pending users with specified filter and pagination
    const pendingUsers = await db
      .select({
        id: users.id,
        firstName: users.firstName,
        lastName: users.lastName,
        email: users.email,
        doctorSpecialty: users.doctorSpecialty,
        accountType: users.accountType,
        countries: users.countries,
        createdAt: users.createdAt,
      })
      .from(users)
      .where(filter)
      .orderBy(desc(users.createdAt))
      .limit(limit)
      .offset(offset);

    console.log(`Found ${pendingUsers.length} pending users`);
    pendingUsers.forEach((user) => {
      console.log(
        `User: ${user.firstName} ${user.lastName}, ID: ${user.id}, accountType: ${user.accountType}`,
      );
    });

    return NextResponse.json({
      users: pendingUsers,
      totalPages: Math.ceil(totalUsers / limit),
      currentPage: page,
    });
  } catch (error) {
    console.error("Error fetching pending users:", error);
    return NextResponse.json(
      { error: "Failed to fetch new users" },
      { status: 500 },
    );
  }
}
