// app/api/admin/GET/existing-users/route.ts

export const dynamic = "force-dynamic";

import { NextRequest, NextResponse } from "next/server";
import { db } from "@/db";
import { users } from "@/db/schema";
import { eq, or, ilike, desc, and } from "drizzle-orm";
import { verifyAdminToken } from "@/utils/adminAPI";

export async function GET(request: NextRequest) {
  try {
    // Verify admin access
    const decoded = await verifyAdminToken(request);
    if (!decoded) {
      return NextResponse.json(
        { message: "Unauthorized access" },
        { status: 403 },
      );
    }

    // Parse query parameters
    const { searchParams } = new URL(request.url);
    const search = searchParams.get("search") || "";

    // Build the where conditions
    const whereConditions = search
      ? and(
          eq(users.authorized, true),
          or(
            ilike(users.lastName, `%${search}%`),
            ilike(users.email, `%${search}%`),
          ),
        )
      : eq(users.authorized, true);

    // Execute query with sorting
    const existingUsers = await db
      .select({
        id: users.id,
        firstName: users.firstName,
        lastName: users.lastName,
        doctorSpecialty: users.doctorSpecialty,
        email: users.email,
        accountType: users.accountType,
        countries: users.countries,
        approvalDate: users.approvalDate,
        authorized: users.authorized,
      })
      .from(users)
      .where(whereConditions)
      .orderBy(desc(users.approvalDate));

    return NextResponse.json({ users: existingUsers });
  } catch (error) {
    console.error("Error fetching existing users:", error);
    return NextResponse.json(
      { error: "Failed to fetch existing users" },
      { status: 500 },
    );
  }
}
