# Team ID from Apple Developer Portal
team_id(ENV['TEAM_ID'] || "YOUR_TEAM_ID")

# iTunes Connect Team ID (if different from Developer Portal Team ID)
itc_team_id(ENV['ITUNES_CONNECT_TEAM_ID'] || ENV['TEAM_ID'] || "YOUR_TEAM_ID")

