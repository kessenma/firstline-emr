# The bundle identifier of your app
app_identifier(ENV['APP_IDENTIFIER'] || "com.fajr.emr")

# Your Apple ID email
apple_id(ENV['APPLE_ID'] || "your-apple-id@example.com")

# For more information about the Appfile, see:
